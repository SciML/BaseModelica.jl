//! base 0.1.0
package 'ArrayModel'
  model 'ArrayModel'
    parameter Integer 'n' = 3;
    parameter Real 'k'['n'] = fill(1.0, 'n') "Rates, sized by a parameter";
    Real 'x'['n'](start = fill(0.0, 'n'), fixed = true) "Vector state";
    Real 'v'[2](start = {1.0, 0.0}, fixed = true);
    parameter Real 'A'[2, 2] = {{0.0, 1.0}, {-1.0, 0.0}};
    Real 'w'[2];
    Real 'total';
    Real 'tail'[2];
    Real 'row'[2];
  equation
    for 'i' in 1:'n' loop
      der('x'['i']) = 'k'['i'] * (1.0 - 'x'['i']);
    end for;
    der('v') = 'A' * 'v';
    'w' = 2.0 * 'v' .+ {1.0, 2.0};
    'total' = sum('x');
    'tail' = 'x'[2:end];
    'row' = ([1.0, 2.0; 3.0, 4.0])[1, :] .* 'A'[2, :];
  end 'ArrayModel';
end 'ArrayModel';
