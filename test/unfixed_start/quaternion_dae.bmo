//! base 0.1.0
package P
model M
  Real Q[4](start = {0.1, 0.2, 0.3, 0.927362});
  Real w[3](start = {1, 0.5, 0}, fixed = {true, true, true});
equation
  w = 2*{Q[4]*der(Q[1]) + Q[3]*der(Q[2]) - Q[2]*der(Q[3]) - Q[1]*der(Q[4]),
        -Q[3]*der(Q[1]) + Q[4]*der(Q[2]) + Q[1]*der(Q[3]) - Q[2]*der(Q[4]),
         Q[2]*der(Q[1]) - Q[1]*der(Q[2]) + Q[4]*der(Q[3]) - Q[3]*der(Q[4])};
  0 = Q[1]^2 + Q[2]^2 + Q[3]^2 + Q[4]^2 - 1;
  der(w) = {0, 0, 0};
end M;
end P;
